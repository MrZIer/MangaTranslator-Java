{
  "info": {
    "name": "Manga Translation API",
    "description": "漫画翻译工具API测试集合",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "sessionId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. 上传文件并开始翻译",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// 保存sessionId到环境变量",
              "if (pm.response.code === 200) {",
              "    var jsonData = pm.response.json();",
              "    if (jsonData.success && jsonData.data.sessionId) {",
              "        pm.collectionVariables.set('sessionId', jsonData.data.sessionId);",
              "        console.log('Session ID saved: ' + jsonData.data.sessionId);",
              "    }",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": "/path/to/manga.png"
            },
            {
              "key": "engine",
              "value": "OPENAI",
              "type": "text"
            },
            {
              "key": "sourceLanguage",
              "value": "ja",
              "type": "text"
            },
            {
              "key": "targetLanguage",
              "value": "zh",
              "type": "text"
            },
            {
              "key": "outputFormat",
              "value": "SINGLE_IMAGE",
              "type": "text"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/api/upload",
          "host": ["{{baseUrl}}"],
          "path": ["api", "upload"]
        },
        "description": "上传漫画图片并启动翻译任务"
      }
    },
    {
      "name": "2. 查询任务进度",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/tasks/{{sessionId}}/progress",
          "host": ["{{baseUrl}}"],
          "path": ["api", "tasks", "{{sessionId}}", "progress"]
        },
        "description": "查询翻译任务的当前进度和状态"
      }
    },
    {
      "name": "3. 获取任务详情",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/tasks/{{sessionId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "tasks", "{{sessionId}}"]
        },
        "description": "获取任务的完整详细信息，包括OCR结果和翻译内容"
      }
    },
    {
      "name": "4. 获取历史记录列表",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/history?page=0&size=10",
          "host": ["{{baseUrl}}"],
          "path": ["api", "history"],
          "query": [
            {
              "key": "page",
              "value": "0"
            },
            {
              "key": "size",
              "value": "10"
            }
          ]
        },
        "description": "获取当前用户的历史翻译记录（分页）"
      }
    },
    {
      "name": "5. 下载翻译结果",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/history/{historyId}/download",
          "host": ["{{baseUrl}}"],
          "path": ["api", "history", "{historyId}", "download"]
        },
        "description": "下载翻译后的图片文件。将{historyId}替换为实际的历史记录ID"
      }
    },
    {
      "name": "6. 延长历史记录保留期",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/history/{historyId}/extend?days=30",
          "host": ["{{baseUrl}}"],
          "path": ["api", "history", "{historyId}", "extend"],
          "query": [
            {
              "key": "days",
              "value": "30"
            }
          ]
        },
        "description": "延长历史记录的保留期限。将{historyId}替换为实际的历史记录ID"
      }
    }
  ]
}
